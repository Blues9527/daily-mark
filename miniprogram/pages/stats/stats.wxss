.stats-page {
  padding-bottom: 48rpx;
}

.stats-head {
  padding-top: 4rpx;
}

.stats-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 4rpx;
}

.stats-title {
  line-height: 1.2;
}

.stats-streak {
  flex: none;
  margin-bottom: 8rpx;
  margin-left: 16rpx;
  font-weight: 600;
}

.stats-range {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
}

.stats-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 40rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background:
    radial-gradient(380rpx 260rpx at 92% 12%, rgba(217, 91, 51, 0.28), transparent 72%),
    linear-gradient(145deg, #2b2721, #1f1c17);
  color: var(--paper);
  box-shadow: 0 24rpx 50rpx rgba(37, 34, 29, 0.2);
}

.stats-hero-main {
  flex: 1;
  min-width: 0;
}

.stats-hero-label {
  display: block;
  color: #bdb2a2;
  font-size: 19rpx;
  letter-spacing: 0.16em;
}

.stats-hero-value-row {
  display: flex;
  align-items: flex-end;
  margin-top: 8rpx;
}

.stats-hero-value {
  font-family: var(--serif);
  font-size: 100rpx;
  font-weight: 600;
  line-height: 0.95;
  letter-spacing: -0.03em;
  font-variant-numeric: tabular-nums;
}

.stats-hero-unit {
  margin-left: 10rpx;
  margin-bottom: 10rpx;
  color: #cfc3b1;
  font-size: 24rpx;
}

.stats-hero-side {
  flex: none;
  max-width: 270rpx;
  margin-left: 24rpx;
  color: #cfc3b1;
  font-size: 20rpx;
  line-height: 1.65;
  text-align: right;
}

.stats-hero-today {
  display: block;
  margin-bottom: 4rpx;
  color: #f0a487;
  font-size: 22rpx;
  font-weight: 500;
}

.stats-hero-note {
  display: block;
}

.stats-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.stats-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stats-card-title {
  font-family: var(--serif);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.stats-card-meta {
  flex: none;
  margin-left: 16rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.45;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.stats-chart {
  display: flex;
  align-items: flex-end;
}

.stats-chart-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-chart-col + .stats-chart-col {
  margin-left: 10rpx;
}

.stats-chart-track {
  width: 100%;
  height: 190rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.stats-chart-bar {
  width: 100%;
  max-width: 30rpx;
  min-height: 4rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: #e6dccd;
}

.stats-chart-col.is-today .stats-chart-bar {
  background: var(--accent);
}

.stats-chart-col.is-empty .stats-chart-bar {
  opacity: 0.5;
}

.stats-chart-label {
  margin-top: 12rpx;
  color: var(--faint);
  font-size: 19rpx;
  line-height: 1;
}

.stats-chart-col.is-today .stats-chart-label {
  color: var(--accent-deep);
  font-weight: 600;
}

.stats-chart-hint {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.6;
}

.stats-tiles {
  display: flex;
  margin-top: 24rpx;
}

.stats-tile {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
  border: 1rpx solid var(--line-soft);
  border-radius: 28rpx;
  background: var(--card);
  box-shadow: 0 12rpx 40rpx rgba(50, 42, 31, 0.045);
}

.stats-tile + .stats-tile {
  margin-left: 14rpx;
}

.stats-tile-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--faint);
  font-size: 18rpx;
  letter-spacing: 0.02em;
}

.stats-tile-value {
  display: flex;
  align-items: baseline;
}

.stats-tile-num {
  font-family: var(--serif);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.stats-tile-unit {
  margin-left: 2rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.stats-tile-value--text {
  align-items: center;
  min-height: 46rpx;
}

.stats-tile-value--text.is-empty .stats-tile-text {
  color: var(--faint);
  font-family: inherit;
  font-size: 24rpx;
  font-weight: 400;
}

.stats-cat-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  flex: none;
  border-radius: 50%;
}

.stats-tile-text {
  font-family: var(--serif);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stats-cal-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-cal-dot {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  border-radius: 8rpx;
  background: var(--paper-2);
}

.stats-cal-dot--1 {
  background: #f1cdbb;
}

.stats-cal-dot--2 {
  background: #e8a17f;
}

.stats-cal-dot--3 {
  background: var(--accent);
}

.stats-cal-dot.is-today {
  box-shadow: 0 0 0 2rpx var(--paper), 0 0 0 5rpx var(--ink);
}

.stats-cal-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  color: var(--faint);
  font-size: 19rpx;
  font-variant-numeric: tabular-nums;
}

.stats-cal-today {
  color: var(--accent-deep);
  font-weight: 600;
}

.stats-cal-hint {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.6;
}

.stats-badges-section {
  margin-top: 32rpx;
}

.stats-badges {
  display: flex;
}

.stats-badge {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 12rpx 20rpx;
  border: 1rpx solid var(--line-soft);
  border-radius: 26rpx;
  background: var(--card);
  box-shadow: 0 12rpx 40rpx rgba(50, 42, 31, 0.045);
  text-align: center;
}

.stats-badge + .stats-badge {
  margin-left: 14rpx;
}

.stats-badge-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-badge-title {
  color: var(--ink-2);
  font-family: var(--serif);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.stats-badge-detail {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.45;
}

.stats-badge.is-locked {
  opacity: 0.52;
}

.stats-badge.is-locked .stats-badge-icon {
  background: var(--paper-2);
}

.stats-action {
  margin-top: 32rpx;
}

.stats-weekly-btn {
  color: var(--ink-2);
}

.stats-weekly-btn .stats-weekly-icon {
  margin-left: 12rpx;
  margin-right: 0;
}

.stats-footnote {
  display: block;
  margin-top: 18rpx;
  color: var(--faint);
  font-size: 19rpx;
  text-align: center;
}
